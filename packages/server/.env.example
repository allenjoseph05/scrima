# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# PostgreSQL (Neon in prod, local docker in dev)
DATABASE_URL=postgresql://postgres:password@localhost:5432/scrima

# Redis (Upstash in prod, local docker in dev)
REDIS_URL=redis://localhost:6379

# Google Gemini (your server-side key — never exposed to clients)
GEMINI_API_KEY=

# Clerk Auth
CLERK_SECRET_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ULTRA_PRICE_ID=

# Cloudflare R2 (temporary video storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=scrima-temp
